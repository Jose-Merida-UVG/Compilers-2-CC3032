// Muchos valores vivos a la vez: el asignador de registros tiene que derramar a memoria.
let a: integer = 1;
let b: integer = 2;
let c: integer = 3;
let d: integer = 4;
let e: integer = 5;
let f: integer = 6;
let g: integer = 7;
let h: integer = 8;
let i: integer = 9;
let j: integer = 10;
let k: integer = 11;
let l: integer = 12;
let m: integer = 13;
print(a + b + c + d + e + f + g + h + i + j + k + l + m);
print((a + b) * (c + d) * (e + f) - (g + h) * (i + j));
let x: float = 1.5;
let y: float = 2.5;
let z: float = 4.0;
print(x * y + z);
