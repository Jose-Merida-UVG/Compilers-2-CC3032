function dia(n: integer) {
    switch (n) {
        case 1:
            print("lunes");
            break;
        case 2:
            print("martes");
        case 3:
            print("miercoles");
            break;
        default:
            print("otro");
    }
}
dia(1);
dia(2);
dia(3);
dia(9);
