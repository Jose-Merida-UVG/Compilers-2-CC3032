let a: integer = 3;
let b: integer = 7;
if (a < b && b < 10) {
    print("A");
}
if (a > b || b == 7) {
    print("B");
}
if (!(a == 3)) {
    print("C");
} else {
    print("D");
}
if (a == 3 && (b < 5 || b > 6)) {
    print("E");
}
let x: float = 1.5;
if (x > 1.0) {
    print("F");
}
if (x == 2.0) {
    print("G");
} else {
    print("H");
}
let s: string = "hola";
if (s == "hola") {
    print("I");
}
if (s != "hola") {
    print("J");
} else {
    print("K");
}
