let a: boolean = true; let b: boolean = false;
print(a && b); print(a || b); print(!a); print(!b && a);
print(1 < 2 && 2 < 3); print(3 <= 3 || 1 / 0 == 1);
print(b && 1 / 0 == 1);
print(5 != 5); print(5 == 5 && !(2 > 3));
let c: integer = 0;
if (c != 0 && 10 / c > 1) { print("no"); } else { print("corto"); }
print("a" == "a"); print("a" != "b");
