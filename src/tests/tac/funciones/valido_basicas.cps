function saludar() { print("hola"); }
function cuadrado(x: integer): integer { return x * x; }
function suma(a: integer, b: integer): integer { return a + b; }
function promedio(a: float, b: float): float { return (a + b) / 2.0; }
function esPar(n: integer): boolean { return n % 2 == 0; }
saludar();
print(cuadrado(4));
let s = suma(2, 3);
print(promedio(1, 2));
print(esPar(s));
